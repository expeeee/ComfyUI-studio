# ComfyUI Studio Configuration (Optional overrides)
STUDIO_HOST=0.0.0.0
STUDIO_PORT=8190

# Upstream ComfyUI connection
STUDIO_COMFYUI_URL=http://127.0.0.1:8188
STUDIO_COMFYUI_WS_URL=ws://127.0.0.1:8188/ws
STUDIO_COMFYUI_ROOT=/opt/comfyui/ComfyUI
STUDIO_COMFYUI_SITE_PACKAGES=/opt/comfyui/venv/lib/python3.12/site-packages

# Model storage directory
STUDIO_MODELS_ROOT=/Beta/ComfyUI/models

# Optional provider tokens (can also be configured in the Studio web UI Settings modal)
# HF_TOKEN=hf_...
# CIVITAI_TOKEN=...
