# ComfyUI Studio Configuration
# Copy this file to .env to customize your local installation:
#   cp .env.example .env

# Network / Bind Configuration
STUDIO_HOST=0.0.0.0
STUDIO_PORT=8190

# Upstream ComfyUI Instance
# (Can also be dynamically modified in the Studio Web UI Settings modal)
STUDIO_COMFYUI_URL=http://127.0.0.1:8188

# Upstream ComfyUI WebSocket URL (Optional: auto-derived from STUDIO_COMFYUI_URL if omitted)
# STUDIO_COMFYUI_WS_URL=ws://127.0.0.1:8188/ws

# Paths & Directories
STUDIO_MODELS_ROOT=/Beta/ComfyUI/models
STUDIO_COMFYUI_ROOT=/opt/comfyui/ComfyUI
STUDIO_COMFYUI_SITE_PACKAGES=/opt/comfyui/venv/lib/python3.12/site-packages
# STUDIO_DATA_DIR=/Fast/AI/ComfyUI/studio/data
# STUDIO_FRONTEND_DIST_DIR=/Fast/AI/ComfyUI/studio/frontend/dist

# Video Processing Defaults
STUDIO_DEFAULT_SEGMENT_SECONDS=10

# AI Assistant Engine (Lemonade / OpenAI compatible)
STUDIO_AI_ENGINE_URL=http://192.168.1.16:13305/v1
STUDIO_AI_ENGINE_MODEL=Qwen3.8-27B-GGUF-Q4_K_M
STUDIO_AI_ENGINE_PROVIDER=lemonade

# Security / CORS
STUDIO_CORS_ORIGINS=*

# Model Provider Tokens (Optional: can also be configured in the Studio web UI Settings modal)
# HF_TOKEN=hf_...
# CIVITAI_TOKEN=...
